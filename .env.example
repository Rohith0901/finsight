# Copy to .env and fill in. Never commit .env.
FINSIGHT_API_TOKEN=run-scripts/new_token.sh-and-paste-here
FINSIGHT_LLM_PROVIDER=ollama            # none | ollama | gemini
FINSIGHT_OLLAMA_URL=http://host.docker.internal:11434
FINSIGHT_OLLAMA_MODEL=qwen2.5:3b
# FINSIGHT_GEMINI_API_KEY=              # optional; use a paid key, send aggregates only
# FINSIGHT_GEMINI_MODEL=gemini-3.5-flash-lite
